# TOCO Technologies UAE - Apache / cPanel Production Configuration
Options -Indexes
ServerSignature Off
AddDefaultCharset UTF-8

# Proper MIME Types for Modern Assets
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html

# HTTPS & Legacy Route Redirects
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS on live production domain (skip localhost / dev environments)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?tocotechnologies\.ae$ [NC]
  RewriteRule ^ https://tocotechnologies.ae%{REQUEST_URI} [L,R=301]

  # Canonical non-www on production domain
  RewriteCond %{HTTP_HOST} ^www\.tocotechnologies\.ae$ [NC]
  RewriteRule ^ https://tocotechnologies.ae%{REQUEST_URI} [L,R=301]

  # Preserve & redirect clean or legacy paths from previous site
  RewriteRule ^home/?$ / [L,R=301]
  RewriteRule ^about/?$ /#about [L,R=301,NE]
  RewriteRule ^services/?$ /#services [L,R=301,NE]
  RewriteRule ^projects/?$ /#portfolio [L,R=301,NE]
  RewriteRule ^portfolio/?$ /#portfolio [L,R=301,NE]
  RewriteRule ^contact/?$ /#contact [L,R=301,NE]
  RewriteRule ^privacy/?$ /privacy-policy.html [L,R=301]
  RewriteRule ^terms/?$ /terms-of-service.html [L,R=301]
  RewriteRule ^refund/?$ /terms-of-service.html#sla [L,R=301,NE]
  RewriteRule ^landing-dubai/?$ / [L,R=301]
</IfModule>

# GZIP / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser Caching for Strong Core Web Vitals
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security & Cache Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|avif|svg|jpg|jpeg|png|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

